FROM php:8.2-cli

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      git \
      unzip \
      libzip-dev \
      sqlite3 \
      libsqlite3-dev \
      curl && \
    docker-php-ext-install zip pcntl pdo pdo_sqlite && \
    rm -rf /var/lib/apt/lists/*

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Cópia isolada do código fonte para a imagem da abstração
COPY repos/codelaravel /app

# Instalação das dependências do Composer (incluindo faker para seeds)
RUN composer install --no-scripts --no-interaction --prefer-dist

COPY docker/entrypoint-codelaravel.sh /usr/local/bin/entrypoint-codelaravel.sh
RUN chmod +x /usr/local/bin/entrypoint-codelaravel.sh

EXPOSE 3003

ENTRYPOINT ["/usr/local/bin/entrypoint-codelaravel.sh"]
